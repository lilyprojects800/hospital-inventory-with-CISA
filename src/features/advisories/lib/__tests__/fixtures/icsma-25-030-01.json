  "vulnerabilities": [
    {
      "cve": "CVE-2024-12248",
      "cwe": {
        "id": "CWE-787",
        "name": "Out-of-bounds Write"
      },
      "notes": [
        {
          "category": "summary",
          "text": "The affected product is vulnerable to an out-of-bounds write, which could allow an attacker to send specially formatted UDP requests in order to write arbitrary data. This could result in remote code execution.",
          "title": "Vulnerability Summary"
        }
      ],
      "product_status": {
        "known_affected": ["CSAFPID-0001", "CSAFPID-0002", "CSAFPID-0003"]
      },
      "remediations": [
        {
          "category": "mitigation",
          "details": "Per FDA recommendation, CISA recommends users remove any Contec CMS8000 devices from their networks.",
          "product_ids": ["CSAFPID-0001", "CSAFPID-0002", "CSAFPID-0003"]
        },
        {
          "category": "mitigation",
          "details": "If asset owners cannot remove the devices from their networks, users should block 202.114.4.0/24 from their networks, or block 202.114.4.119 and 202.114.4.120.",
          "product_ids": ["CSAFPID-0001", "CSAFPID-0002", "CSAFPID-0003"]
        },
        {
          "category": "mitigation",
          "details": "Please note that this device may be re-labeled and sold by resellers. For a list of known re-labeled devices, please refer to FDA's safety communication.",
          "product_ids": ["CSAFPID-0001", "CSAFPID-0002", "CSAFPID-0003"],
          "url": "https://www.fda.gov/medical-devices/safety-communications/cybersecurity-vulnerabilities-certain-patient-monitors-contec-and-epsimed-fda-safety-communication"
        }
      ],
      "scores": [
        {
          "cvss_v3": {
            "baseScore": 9.8,
            "baseSeverity": "CRITICAL",
            "vectorString": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H",
            "version": "3.1"
          },
          "products": ["CSAFPID-0001", "CSAFPID-0002", "CSAFPID-0003"]
        }
      ]
    },
    {
      "cve": "CVE-2025-0626",
      "cwe": {
        "id": "CWE-912",
        "name": "Hidden Functionality"
      },
      "notes": [
        {
          "category": "summary",
          "text": "The \"monitor\" binary in the firmware of the affected product attempts to mount to a hard-coded, routable IP address, bypassing existing device network settings to do so. The function also enables the network interface of the device if it is disabled. The function is triggered by attempting to update the device from the user menu. This could serve as a backdoor to the device, and could lead to a malicious actor being able to upload and overwrite files on the device.",
          "title": "Vulnerability Summary"
        }
      ],
